# The Django app renders its own page either way, so both states are asserted
# from its markup rather than from Ory's UI. The previous test drove Ory's
# hosted Account Experience by CSS selector, which is why it rotted.
ENTRY_INTERNAL=http://django:8000
ENTRY_HOST=127.0.0.1:8000
ENTRY_PATH=/
READY_URL=http://django:8000/
NEEDS_SESSION=1
EXPECT_ANON_STATUS=200
EXPECT_ANON_BODY=You are not signed in
EXPECT_INVALID_COOKIE_STATUS=200
EXPECT_AUTH_STATUS=200
# The harness registers a smoke-…@example.com identity, so finding that address
# in the page proves Django resolved the cookie and rendered the identity's own
# traits — not merely that some signed-in page was returned.
EXPECT_AUTH_BODY=@example.com
