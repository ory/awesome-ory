# 09 proxies a websocket service through Oathkeeper. The ws service serves the
# demo page on / and the socket on /ws — there is no /hello here. The point of
# the example is that the upgrade survives the proxy, so the handshake is
# asserted as well as the page.
ENTRY_INTERNAL=http://oathkeeper:4455
ENTRY_HOST=127.0.0.1:8080
ENTRY_PATH=/
NEEDS_SESSION=1
EXPECT_ANON_STATUS=401
EXPECT_ANON_BROWSER_STATUS=302
EXPECT_ANON_BROWSER_LOCATION=/login
EXPECT_AUTH_STATUS=200
WS_PATH=/ws
EXPECT_WS_STATUS=101
