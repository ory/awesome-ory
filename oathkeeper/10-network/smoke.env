# 10-network is the one example backed by Ory Network rather than a self-hosted
# Kratos: Oathkeeper's cookie_session authenticator checks sessions through the
# Ory tunnel running on the host. The session is minted against the tunnel and
# passed in, so this file describes only what the proxy should do with it.
ENTRY_INTERNAL=http://oathkeeper:4455
ENTRY_HOST=127.0.0.1:8080
ENTRY_PATH=/hello
NEEDS_SESSION=1
EXPECT_ANON_STATUS=401
EXPECT_ANON_BROWSER_STATUS=302
EXPECT_ANON_BROWSER_LOCATION=/ui/login
EXPECT_AUTH_STATUS=200
# This example uses the `header` mutator, so the upstream sees X-User set to
# the Ory Network identity id.
EXPECT_AUTH_HEADERS=X-User=*
