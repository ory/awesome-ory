# In 05 nginx is the edge and Oathkeeper runs purely as a decision API behind
# `auth_request`. nginx rewrites Oathkeeper's 401 into its own 302 via
# `error_page 401`, so the JSON error handler the access rule configures is only
# observable on the decision API itself — which is why both are asserted.
ENTRY_INTERNAL=http://nginx:80
ENTRY_HOST=127.0.0.1:8080
ENTRY_PATH=/hello
READY_URL=http://nginx:80
NEEDS_SESSION=1
EXPECT_ANON_STATUS=302
EXPECT_ANON_LOCATION=/login
EXPECT_AUTH_STATUS=200
EXPECT_AUTH_HEADERS=X-User=*
DECISION_URL=http://oathkeeper:4456/decisions/hello
EXPECT_DECISION_STATUS=401
