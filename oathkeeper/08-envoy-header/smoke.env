# In 08 Envoy is the edge and calls Oathkeeper's decision API through its
# `ext_authz` HTTP filter. Envoy listens on 10000 and is published on 8000 —
# not 8080 like the other examples.
ENTRY_INTERNAL=http://envoy:10000
ENTRY_HOST=127.0.0.1:8000
ENTRY_PATH=/hello
READY_URL=http://envoy:10000
NEEDS_SESSION=1
EXPECT_ANON_STATUS=401
EXPECT_AUTH_STATUS=200
EXPECT_AUTH_HEADERS=X-User=*
DECISION_URL=http://oathkeeper:4456/decisions/hello
EXPECT_DECISION_STATUS=401
