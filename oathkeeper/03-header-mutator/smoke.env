# 03 adds the `header` mutator: the authenticated request reaches the upstream
# with `X-User` set to the Kratos identity id.
ENTRY_INTERNAL=http://oathkeeper:4455
ENTRY_HOST=127.0.0.1:8080
ENTRY_PATH=/hello
NEEDS_SESSION=1
EXPECT_ANON_STATUS=401
EXPECT_ANON_BROWSER_STATUS=302
EXPECT_ANON_BROWSER_LOCATION=/login
EXPECT_AUTH_STATUS=200
EXPECT_AUTH_HEADERS=X-User=*
