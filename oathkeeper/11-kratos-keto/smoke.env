# 11 adds Ory Keto: authentication is not enough, the identity also needs a
# relation tuple granting it `access` to the object. A signed-in identity is
# therefore refused until the tuple is written, which is what makes this a
# permissions example rather than another authentication one.
ENTRY_INTERNAL=http://oathkeeper:4455
ENTRY_HOST=127.0.0.1:8080
ENTRY_PATH=/hello
NEEDS_SESSION=1
EXPECT_ANON_STATUS=401
EXPECT_ANON_BROWSER_STATUS=302
EXPECT_ANON_BROWSER_LOCATION=/login
EXPECT_AUTH_STATUS=403
GRANT_NAMESPACE=services
GRANT_OBJECT=hello-world-service
GRANT_RELATION=access
KETO_WRITE_URL=http://keto:4467
EXPECT_AUTH_STATUS_AFTER_GRANT=200
