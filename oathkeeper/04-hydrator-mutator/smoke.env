# 04 swaps the `header` mutator for the `hydrator` mutator, which calls out to
# the local hydrator service and lets it enrich the session with extra headers.
ENTRY_INTERNAL=http://oathkeeper:4455
ENTRY_HOST=127.0.0.1:8080
ENTRY_PATH=/hello
NEEDS_SESSION=1
EXPECT_ANON_STATUS=401
EXPECT_ANON_BROWSER_STATUS=302
EXPECT_ANON_BROWSER_LOCATION=/login
EXPECT_AUTH_STATUS=200
EXPECT_AUTH_HEADERS=X-User-Name=Andrew X-User-Company=Ory X-User-Role=admin
