# 12 lists two authenticators: `cookie_session` first, then `anonymous`. An
# unauthenticated request is therefore not denied — it falls through to
# `anonymous` and reaches the upstream as the subject "guest". The point of the
# example is that the subject differs, not that access is refused.
ENTRY_INTERNAL=http://oathkeeper:4455
ENTRY_HOST=127.0.0.1:8080
ENTRY_PATH=/hello
NEEDS_SESSION=1
EXPECT_ANON_STATUS=200
EXPECT_ANON_HEADERS=X-User=guest
EXPECT_AUTH_STATUS=200
EXPECT_AUTH_HEADERS=X-User=*
