# 02 protects the upstream with the `cookie_session` authenticator and a `noop`
# mutator. Oathkeeper's `redirect` error handler only fires for `Accept:
# text/html`, so an API client falls through to the `json` handler and gets a
# 401 while a browser gets sent to the login UI.
ENTRY_INTERNAL=http://oathkeeper:4455
ENTRY_HOST=127.0.0.1:8080
ENTRY_PATH=/hello
NEEDS_SESSION=1
EXPECT_ANON_STATUS=401
EXPECT_ANON_BROWSER_STATUS=302
EXPECT_ANON_BROWSER_LOCATION=/login
EXPECT_AUTH_STATUS=200
