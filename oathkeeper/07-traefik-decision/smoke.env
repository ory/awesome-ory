# In 07 Traefik is the edge and calls Oathkeeper's decision API through its
# `forwardAuth` middleware. Traefik returns Oathkeeper's status verbatim, so the
# anonymous request surfaces the JSON handler's 401 rather than a redirect.
ENTRY_INTERNAL=http://traefik:80
ENTRY_HOST=127.0.0.1:8080
ENTRY_PATH=/hello
READY_URL=http://traefik:80
NEEDS_SESSION=1
EXPECT_ANON_STATUS=401
EXPECT_AUTH_STATUS=200
EXPECT_AUTH_HEADERS=X-User=*
DECISION_URL=http://oathkeeper:4456/decisions/hello
EXPECT_DECISION_STATUS=401
