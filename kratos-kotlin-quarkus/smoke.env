# /recipe carries @Secured, so it is the page that proves the filter asks Kratos
# about the session cookie. An anonymous visitor is sent back to the home page.
# The signed-in half is asserted by smoke.extra.sh, which signs up and logs in
# through the app's own forms: those forms are what this example teaches, and the
# shared runner's API-style session minting would skip them.
ENTRY_INTERNAL=http://quarkus:8080
ENTRY_HOST=127.0.0.1:8080
ENTRY_PATH=/recipe
READY_URL=http://quarkus:8080/
NEEDS_SESSION=0
EXPECT_ANON_STATUS=307
EXPECT_ANON_LOCATION=http://127.0.0.1:8080/
