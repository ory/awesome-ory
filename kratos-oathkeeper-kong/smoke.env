# Kong is the API gateway in front of Oathkeeper, which protects two upstreams.
# Kong rewrites the Host header to the upstream it routes to, so Oathkeeper sees
# `oathkeeper:4455` — which is what the access rules match on here.
ENTRY_INTERNAL=http://kong:8000
ENTRY_HOST=127.0.0.1:8000
ENTRY_PATH=/hello
READY_URL=http://kong:8000
NEEDS_SESSION=1
EXPECT_ANON_STATUS=401
EXPECT_ANON_BROWSER_STATUS=302
EXPECT_ANON_BROWSER_LOCATION=/login
EXPECT_AUTH_STATUS=200
AUTH_EXTRA_PATHS=/world
