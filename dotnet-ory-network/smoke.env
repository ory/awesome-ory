# /Home/IdentityInfo carries [Authorize], so it is the page that proves the Ory
# authentication handler resolved the session cookie into claims. Anonymous
# requests are challenged; authenticated ones render the claims table.
ENTRY_INTERNAL=http://app:5286
ENTRY_HOST=127.0.0.1:5286
ENTRY_PATH=/Home/IdentityInfo
READY_URL=http://app:5286/
NEEDS_SESSION=1
EXPECT_ANON_STATUS=401
EXPECT_AUTH_STATUS=200
EXPECT_AUTH_BODY=You are authenticated
