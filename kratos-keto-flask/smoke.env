# The Flask app checks two things on every request to /: that Kratos recognises
# the session, and that Keto grants that identity `read` on the homepage. So an
# authenticated user is still refused until the relation tuple exists — which is
# what makes this a permissions example and not just an authentication one.
ENTRY_INTERNAL=http://flask:5001
ENTRY_HOST=127.0.0.1:5001
ENTRY_PATH=/
READY_URL=http://flask:5001/oathkeeper
NEEDS_SESSION=1
EXPECT_ANON_STATUS=302
EXPECT_ANON_LOCATION=4455
EXPECT_AUTH_STATUS=403
GRANT_NAMESPACE=app
GRANT_OBJECT=homepage
GRANT_RELATION=read
KETO_WRITE_URL=http://keto:4467
EXPECT_AUTH_STATUS_AFTER_GRANT=200
EXPECT_INVALID_COOKIE_STATUS=403
